{
  "name": "drink-it",
  "version": "1.0.0",
  "private": true,
  "description": "Drink it — Bangladesh's online store for every cold drink can. Zero-dependency Node server + static storefront.",
  "keywords": [
    "ecommerce",
    "bangladesh",
    "storefront",
    "nodejs",
    "vanilla-js"
  ],
  "homepage": "https://github.com/mahmudultopu/drink-it#readme",
  "bugs": {
    "url": "https://github.com/mahmudultopu/drink-it/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahmudultopu/drink-it.git"
  },
  "license": "MIT",
  "author": "Mahmudul Hasan Topu",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "node server.js",
    "build": "node scripts/build-assets.mjs",
    "test": "node --test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test",
    "audit:prod": "npm audit --omit=dev --audit-level=low",
    "measure": "node scripts/measure.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "build:catalog": "node scripts/build.mjs",
    "build:images": "node scripts/render/derive.mjs",
    "build:fonts": "node scripts/get-fonts.mjs",
    "render": "node scripts/render/render.mjs all",
    "render:products": "node scripts/render/render.mjs build",
    "render:scenes": "node scripts/render/render.mjs scenes"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "opentype.js": "^2.0.0",
    "prettier": "^3.9.10",
    "puppeteer-core": "^25.14.0",
    "sharp": "^0.35.5",
    "three": "^0.170.0"
  }
}
