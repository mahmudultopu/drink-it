{
  "name": "drink-it",
  "version": "1.0.0",
  "private": true,
  "description": "Drink it — Bangladesh's online store for every cold drink can. Zero-dependency Node server + static storefront.",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "build:catalog": "node scripts/build.mjs",
    "render": "node scripts/render/render.mjs all",
    "render:products": "node scripts/render/render.mjs build",
    "render:scenes": "node scripts/render/render.mjs scenes",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "esbuild": "^0.24.2",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "opentype.js": "^1.3.4",
    "prettier": "^3.4.2",
    "puppeteer-core": "^23.11.1",
    "sharp": "^0.33.5",
    "three": "^0.170.0"
  }
}
